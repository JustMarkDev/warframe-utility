{
  "name": "warframe-utility",
  "version": "0.4.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "preview": "vp preview",
    "tauri": "tauri",
    "update-mods": "bun scripts/update-mods.js",
    "build": "vp build",
    "check": "bun run check:js && bun run check:rust",
    "check:js": "vp check && bun run typecheck",
    "typecheck": "bun check --no-script",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && bun run lint:rust",
    "lint": "vp lint && bun run lint:rust",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings",
    "format": "vp fmt && bun run format:rust",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "test": "bun run test:js && bun run test:rust",
    "test:js": "vp test run --passWithNoTests",
    "test:rust": "cargo nextest run --manifest-path src-tauri/Cargo.toml --locked",
    "prepare": "vp config"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  }
}
