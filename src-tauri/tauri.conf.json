{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WarframeUtility",
  "version": "0.4.7",
  "identifier": "com.warframe.market.utility",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Warframe Market Syndicate Automator",
        "width": 1000,
        "height": 720,
        "resizable": true,
        "transparent": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCMERFRjc4MzhCQTA4OEYKUldTUENMbzRlTzhOTzZ1SHZRQUlvMEdQV3BJZmZ6QVNwekFPVXB6NkJMb2NUTUp6VzdBQyt4K0sK",
      "endpoints": [
        "https://github.com/JustMarkDev/Warframe-Utility/releases/latest/download/latest.json"
      ]
    }
  }
}
